{
  "name": "uchat-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json --allowed-hosts all",
    "build": "ng build",
    "test": "sh -c 'vitest run --coverage'",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json,md}\""
  },
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@stomp/rx-stomp": "^2.4.0",
    "rxjs": "^7.8.0",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.6.0",
    "uuid": "^11.1.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.1",
    "@analogjs/vitest-angular": "2.7.1",
    "@angular-devkit/build-angular": "21.2.28",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "21.2.28",
    "@angular/compiler-cli": "21.2.25",
    "@stomp/stompjs": "^7.1.1",
    "@types/jasmine": "^4.3.0",
    "@types/node": "^20.11.0",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript-eslint/utils": "^8.69.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.4",
    "jasmine-core": "^5.12.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7",
    "uuid": "$uuid",
    "jsdom": {
      "undici": "8.12.2"
    }
  }
}
