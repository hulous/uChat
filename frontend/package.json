{
  "name": "uchat-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json --allowed-hosts all",
    "build": "ng build",
    "test": "sh -c 'vitest run --coverage'",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json,md}\""
  },
  "dependencies": {
    "@angular/animations": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-browser-dynamic": "22.3.0",
    "@angular/router": "22.3.0",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "@stomp/rx-stomp": "^2.4.0",
    "rxjs": "^7.8.2",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.9.1",
    "uuid": "^14.0.3",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "3.0.0",
    "@analogjs/vitest-angular": "3.0.0",
    "@angular-devkit/build-angular": "22.3.0",
    "@angular-eslint/builder": "^22.8.0",
    "@angular-eslint/eslint-plugin": "^22.8.0",
    "@angular-eslint/eslint-plugin-template": "^22.8.0",
    "@angular-eslint/schematics": "^22.8.0",
    "@angular-eslint/template-parser": "^22.8.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@stomp/stompjs": "^7.5.0",
    "@types/jasmine": "^7.0.0",
    "@types/node": "^20.11.0",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@typescript-eslint/utils": "^8.74.0",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^7.0.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.2"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7",
    "uuid": "$uuid",
    "jsdom": {
      "undici": "8.12.2"
    }
  }
}
